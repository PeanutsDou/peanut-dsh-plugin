{
  "name": "@deepseek-ai/dsh-schedule-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Schedule management UI for DeepSeek Harness: a session-header entry that lists, creates, and deletes session-local reminders by reusing the shipped dsh-schedule backend.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/wrap-client.mjs"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-schedule": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-time-context": "*",
    "react": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "typescript": "^5.9.3"
  }
}
